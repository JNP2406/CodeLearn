<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CodeLearn"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.onboarding.OnboardingActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.auth.SignUpActivity"
            android:exported="false" />

        <activity
            android:name=".ui.auth.SignInActivity"
            android:exported="false" />

        <activity
            android:name=".ui.student.StudentHomeActivity"
            android:exported="false" />

        <activity
            android:name=".ui.student.CourseDetailActivity"
            android:exported="false" />

        <activity
            android:name=".ui.student.CourseSectionActivity"
            android:exported="false" />

        <activity
            android:name=".ui.student.QuizActivity"
            android:exported="false" />

        <activity
            android:name=".ui.student.QuizResultActivity"
            android:exported="false" />

        <activity
            android:name=".ui.student.CaseStudyActivity"
            android:exported="false" />

        <activity
            android:name=".ui.student.StudentProfileActivity"
            android:exported="false" />

        <activity
            android:name=".ui.mentor.MentorChatsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.mentor.MentorProfileActivity"
            android:exported="false" />

        <activity
            android:name=".ui.student.FindMentorActivity"
            android:exported="false" />

        <activity
            android:name=".ui.student.StudentMentorActivity"
            android:exported="false" />

        <activity
            android:name=".ui.mentor.MentorCaseStudyReviewActivity"
            android:exported="false" />

        <activity
            android:name=".ui.student.StudentChatActivity"
            android:exported="false" />

        <activity
            android:name=".ui.mentor.MentorChatActivity"
            android:exported="false" />

        <activity
            android:name=".ui.student.StudentCalendarActivity"
            android:exported="false" />

        <activity
            android:name=".ui.mentor.MentorCalendarActivity"
            android:exported="false" />

        <activity
            android:name=".ui.NotificationActivity"
            android:exported="false" />

    </application>

</manifest>